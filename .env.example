# Telegram bot tokeni (@BotFather dan olinadi)
TELEGRAM_BOT_TOKEN=

# OpenAI API kaliti (matn tahlili, ovozni matnga o'girish, hujjat tahlili uchun)
OPENAI_API_KEY=

# Google Sheets sozlamalari
# Mahalliy ishga tushirishda: credentials.json faylini ko'rsatadi
GOOGLE_CREDENTIALS_FILE=credentials.json
# Bulutli serverga (Railway/Render) joylashtirilganda: credentials.json faylining
# to'liq matnini shu o'zgaruvchiga joylang (fayl o'rniga ishlatiladi, agar to'ldirilgan bo'lsa)
GOOGLE_CREDENTIALS_JSON=
SPREADSHEET_ID=
WORKSHEET_NAME=Tranzaksiyalar

# ixtiyoriy: GPT modeli nomi
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_TRANSCRIBE_MODEL=whisper-1

# botdan foydalanishga ruxsat berilgan Telegram foydalanuvchi ID'lari (vergul bilan ajratib)
# bo'sh qoldirilsa - bot hamma uchun ochiq bo'ladi
ALLOWED_USER_IDS=6873991787
